img.image-thumb{
    border-radius: 5px;
    cursor: pointer;
    transition: 0.3s;
}
img.image-thumb:hover {opacity: 0.7;}

.modal-backdrop {
    display: none;
    position: fixed;
    z-index: 1;
	margin-top: 50px;
    padding-top: 100px;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgb(0,0,0);
    background-color: rgba(0,0,0,0.7);
}

.modal-content {
    margin: auto;
    display: block;
    width: 75%;
    max-width: 850px;
}

#caption {
    margin: auto;
    display: block;
    width: 80%;
    max-width: 700px;
    text-align: center;
    color: #ccc;
    padding: 10px 0;
    height: 150px;
}

.modal-content, #caption{    
    -webkit-animation-name: zoom;
    -webkit-animation-duration: 0.6s;
    animation-name: zoom;
    animation-duration: 0.6s;
}
.modal-button {    
    -webkit-animation-name: zoom;
    -webkit-animation-duration: 1.5s;
    animation-name: zoom;
    animation-duration: 1.4s;
}

@-webkit-keyframes zoom {
    from {-webkit-transform:scale(0)} 
    to {-webkit-transform:scale(1)}
}

@keyframes zoom {
    from {transform:scale(0)} 
    to {transform:scale(1)}
}

.modal-button {
    position: absolute;
	padding: 0 4px;
	margin: 10px 0 0 3px;
    color: #ccc;
	line-height: 1;
    font-size: 20px;
    font-weight: bold;
    /*transition: 0.3s;*/
	border: 1px solid #f1f1f1;
	border-radius: 48%;
}

.modal-button:hover,
.modal-button:focus {
    color: #fff;
	border-color: #fff;
    text-decoration: none;
    cursor: pointer;
}

@media only screen and (max-width: 700px){
    .modal-content {
        width: 100%;
    }
}
